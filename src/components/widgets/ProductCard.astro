---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import type { Locale } from '~/utils/i18n';
import { t, getLocalePath } from '~/utils/i18n';

interface Cover {
  light: ImageMetadata;
  dark: ImageMetadata;
  kind: 'shot' | 'diagram';
}

interface Props {
  title: string;
  titleEs: string;
  slug: string;
  excerpt: string;
  excerptEs: string;
  icon: string;
  category: string;
  date: Date;
  tags: string[];
  proprietary: boolean;
  cover?: Cover;
  locale?: Locale;
}

const { title, titleEs, slug, excerpt, excerptEs, icon, category, date, tags, proprietary, cover, locale = 'en' } =
  Astro.props;

const displayTitle = locale === 'es' ? titleEs : title;
const displayExcerpt = locale === 'es' ? excerptEs : excerpt;
const categoryLabel = t(`category.${category}`, locale);
const href = getLocalePath(`/portfolio/${slug}`, locale);
const dateStr = date.toLocaleDateString(locale === 'es' ? 'es-CL' : 'en-US', { year: 'numeric', month: 'short' });
const coverFit = cover?.kind === 'diagram' ? 'object-contain p-3' : 'object-cover object-top';
---

<article
  class="group relative flex flex-col overflow-hidden rounded-xl border border-gray-200 bg-white shadow-sm transition-all duration-300 hover:shadow-lg hover:border-primary/40 dark:border-gray-700/50 dark:bg-gray-800/50 dark:hover:border-primary/40"
>
  <!-- Cover -->
  <div class="relative aspect-[16/10] overflow-hidden border-b border-gray-100 bg-gray-50 dark:border-gray-700/50 dark:bg-gray-900/40">
    {
      cover ? (
        <>
          <Image
            src={cover.light}
            alt={displayTitle}
            class:list={['h-full w-full transition-transform duration-500 group-hover:scale-[1.03] dark:hidden', coverFit]}
            loading="lazy"
            width={640}
          />
          <Image
            src={cover.dark}
            alt={displayTitle}
            class:list={['hidden h-full w-full transition-transform duration-500 group-hover:scale-[1.03] dark:block', coverFit]}
            loading="lazy"
            width={640}
          />
        </>
      ) : (
        <div class="flex h-full w-full items-center justify-center bg-gradient-to-br from-primary/5 to-primary/15 dark:from-primary/10 dark:to-primary/25">
          <Icon name={icon} class="h-14 w-14 text-primary/70" />
        </div>
      )
    }
    {
      proprietary && (
        <span class="absolute right-3 top-3 inline-flex items-center rounded-full bg-amber-100/95 px-2.5 py-0.5 text-xs font-medium text-amber-800 shadow-sm dark:bg-amber-900/60 dark:text-amber-300">
          <Icon name="tabler:lock" class="mr-1 h-3 w-3" />
          {locale === 'es' ? 'Propietario' : 'Proprietary'}
        </span>
      )
    }
  </div>

  <!-- Body -->
  <div class="flex flex-1 flex-col p-6">
    <div class="mb-2 flex items-center gap-2 text-xs">
      <span class="font-medium uppercase tracking-wider text-primary">{categoryLabel}</span>
      <span class="text-gray-300 dark:text-gray-600">·</span>
      <span class="text-muted">{dateStr}</span>
    </div>

    <h3
      class="mb-2 text-lg font-bold leading-tight text-gray-900 transition-colors group-hover:text-primary dark:text-white"
    >
      <a href={href} class="after:absolute after:inset-0">{displayTitle}</a>
    </h3>

    <p class="mb-4 flex-1 text-sm leading-relaxed text-muted line-clamp-3">{displayExcerpt}</p>

    <div class="mt-auto flex flex-wrap gap-1.5">
      {
        tags
          .slice(0, 4)
          .map((tag) => (
            <span class="inline-flex items-center rounded-md bg-gray-100 px-2 py-0.5 text-xs font-medium text-gray-600 dark:bg-gray-700/60 dark:text-gray-300">
              {tag}
            </span>
          ))
      }
      {tags.length > 4 && <span class="inline-flex items-center px-1 py-0.5 text-xs text-muted">+{tags.length - 4}</span>}
    </div>
  </div>
</article>

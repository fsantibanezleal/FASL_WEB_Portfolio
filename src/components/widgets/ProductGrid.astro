---
import type { ImageMetadata } from 'astro';
import ProductCard from './ProductCard.astro';
import type { Locale } from '~/utils/i18n';
import { t } from '~/utils/i18n';
import { familyOf, FAMILY_ORDER, type Family } from '~/utils/products';

interface Product {
  data: {
    title: string;
    titleEs: string;
    slug: string;
    excerpt: string;
    excerptEs: string;
    icon: string;
    category: string;
    date: Date;
    tags: string[];
    proprietary: boolean;
    family?: string;
    assetPatterns?: string[];
  };
}

interface Props {
  products: Product[];
  locale?: Locale;
}

const { products, locale = 'en' } = Astro.props;

// ---- cover-image resolution -------------------------------------------------
// A card cover is (in order): the light/dark app screenshot, else the product's
// theme-aware SVG diagram, else nothing (the card falls back to its icon tile).
const allScreens = import.meta.glob<{ default: ImageMetadata }>('/src/assets/images/projects/screenshots/*.png', {
  eager: true,
});
const allDiagrams = import.meta.glob<{ default: ImageMetadata }>('/src/assets/images/projects/diagrams/*.svg', {
  eager: true,
});
const screenBy = (suffix: string) =>
  Object.fromEntries(
    Object.entries(allScreens)
      .filter(([p]) => p.endsWith(suffix))
      .map(([p, m]) => [p.split('/').pop()!.replace(suffix, ''), m.default])
  );
const lightBySlug = screenBy('_app_light.png');
const darkBySlug = screenBy('_app_dark.png');

function diagramFor(patterns: string[]): ImageMetadata | undefined {
  const hit = Object.entries(allDiagrams).find(([p]) =>
    patterns.some((pat) => p.toLowerCase().includes(pat.toLowerCase()))
  );
  return hit?.[1].default;
}

function coverFor(p: Product) {
  const slug = p.data.slug;
  const light = lightBySlug[slug];
  const dark = darkBySlug[slug];
  if (light) return { light, dark: dark ?? light, kind: 'shot' as const };
  const svg = diagramFor(p.data.assetPatterns ?? [slug]);
  if (svg) return { light: svg, dark: svg, kind: 'diagram' as const };
  return undefined;
}

// ---- group into families ----------------------------------------------------
const groups = FAMILY_ORDER.map((family) => ({
  family,
  items: products.filter((p) => familyOf(p.data) === family),
})).filter((g) => g.items.length > 0);

const filters: (Family | 'all')[] = ['all', ...groups.map((g) => g.family)];
---

<section class="relative py-12 md:py-20" id="portfolio">
  <div class="mx-auto max-w-7xl px-4 sm:px-6">
    <div class="mb-10 text-center">
      <p class="text-base font-semibold uppercase tracking-wide text-primary">{t('portfolio.tagline', locale)}</p>
      <h2 class="mt-2 text-3xl font-bold tracking-tight text-gray-900 dark:text-white sm:text-4xl">
        {t('portfolio.title', locale)}
      </h2>
      <p class="mx-auto mt-4 max-w-2xl text-lg text-muted">{t('portfolio.subtitle', locale)}</p>
    </div>

    <!-- Family filter (6 groups instead of a wall of categories) -->
    <div class="mb-12 flex flex-wrap justify-center gap-2" id="family-filter">
      {
        filters.map((f) => (
          <button
            data-family={f}
            class:list={[
              'filter-btn rounded-full px-4 py-2 text-sm font-medium transition-all duration-200',
              f === 'all'
                ? 'bg-primary text-white'
                : 'bg-gray-100 text-gray-700 hover:bg-primary/10 hover:text-primary dark:bg-gray-800 dark:text-gray-300 dark:hover:bg-primary/20',
            ]}
          >
            {t(`family.${f}`, locale)}
          </button>
        ))
      }
    </div>

    <!-- One titled section per family -->
    {
      groups.map((g) => (
        <div class="family-section mb-16 scroll-mt-24" data-family={g.family} id={`fam-${g.family}`}>
          <div class="mb-6 border-b border-gray-200 pb-4 dark:border-gray-700/60">
            <div class="flex items-baseline justify-between gap-4">
              <h3 class="text-2xl font-bold tracking-tight text-gray-900 dark:text-white">
                {t(`family.${g.family}`, locale)}
              </h3>
              <span class="shrink-0 text-sm text-muted">{g.items.length}</span>
            </div>
            <p class="mt-2 max-w-3xl text-sm text-muted">{t(`family.${g.family}.blurb`, locale)}</p>
          </div>
          <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
            {g.items.map((product) => (
              <div data-family={g.family} class="product-item">
                <ProductCard {...product.data} cover={coverFor(product)} locale={locale} />
              </div>
            ))}
          </div>
        </div>
      ))
    }
  </div>
</section>

<script>
  function setupFamilyFilter() {
    const filter = document.getElementById('family-filter');
    if (!filter) return;
    const buttons = filter.querySelectorAll<HTMLButtonElement>('.filter-btn');
    const sections = document.querySelectorAll<HTMLElement>('.family-section');

    buttons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const family = btn.getAttribute('data-family');
        buttons.forEach((b) => {
          b.classList.remove('bg-primary', 'text-white');
          b.classList.add('bg-gray-100', 'text-gray-700', 'dark:bg-gray-800', 'dark:text-gray-300');
        });
        btn.classList.add('bg-primary', 'text-white');
        btn.classList.remove('bg-gray-100', 'text-gray-700', 'dark:bg-gray-800', 'dark:text-gray-300');
        sections.forEach((s) => {
          s.style.display = family === 'all' || s.getAttribute('data-family') === family ? '' : 'none';
        });
      });
    });
  }
  // astro:page-load fires on first load AND after every client-side (View Transitions) nav.
  document.addEventListener('astro:page-load', setupFamilyFilter);
</script>
